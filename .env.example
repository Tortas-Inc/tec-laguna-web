# Copia este archivo a .env.local para desarrollar sin depender del
# portal real del ITL (útil si no tienes red hacia apps2.itlalaguna.edu.mx
# o quieres iterar rápido en la UI).
#
# Con esto activo, lib/scraping/constants.ts apunta al mock server local
# en vez del portal real. Corre el mock server en otra terminal:
#   npm run mock:itl
#
# Requiere el HTML de mocks/html/ (sí está en el repo).
MOCK_ITL=true
MOCK_ITL_PORT=4310
